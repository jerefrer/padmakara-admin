# Database
DATABASE_URL=postgresql://padmakara:your-db-password@localhost:5432/padmakara

# Test database (local development only, not needed in production)
# TEST_DATABASE_URL=postgresql://localhost:5432/padmakara_test

# JWT — generate with: openssl rand -base64 32
JWT_SECRET=change-me-to-a-random-secret-in-production
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d

# AWS (Batch GPU jobs for read-along/subtitles + SES email). Real AWS creds.
AWS_ACCESS_KEY_ID=your-aws-key
AWS_SECRET_ACCESS_KEY=your-aws-secret
AWS_REGION=eu-west-3

# Object storage (audio, PDFs, images, ZIPs).
# Bucket name (same var on AWS S3 and Cloudflare R2):
S3_BUCKET=your-s3-bucket-name
# --- Cloudflare R2 (leave blank to use AWS S3 with the AWS_* creds above) ---
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_FORCE_PATH_STYLE=true
# STORAGE_ACCESS_KEY_ID=your-r2-access-key-id
# STORAGE_SECRET_ACCESS_KEY=your-r2-secret-access-key
# STORAGE_REGION=auto

# Email (AWS SES)
SES_FROM_EMAIL=no-reply@padmakara.pt

# App
PORT=3000
NODE_ENV=production
FRONTEND_URL=https://your-domain.com
ADMIN_URL=https://admin.your-domain.com
BACKEND_URL=https://api.your-domain.com

# Easypay (Payment)
EASYPAY_ACCOUNT_ID=your-easypay-account-id
EASYPAY_API_KEY=your-easypay-api-key
EASYPAY_TESTING=false

# Read-Along (AWS Batch)
BATCH_JOB_DEFINITION=padmakara-read-along
BATCH_JOB_QUEUE=padmakara-read-along-queue
READ_ALONG_WEBHOOK_SECRET=generate-a-random-secret

# Bunny Stream — video hosting & delivery
# Library ID and CDN hostname are visible in the Bunny dashboard (Stream → API tab).
# API Key has full read/write on the library — keep it server-side only.
# Token Authentication Key signs short-lived playback URLs — enable Token Auth in Library → Security.
BUNNY_STREAM_LIBRARY_ID=your-library-id
BUNNY_STREAM_API_KEY=your-stream-api-key
BUNNY_STREAM_CDN_HOSTNAME=vz-xxxxxxxx-xxx.b-cdn.net
BUNNY_STREAM_TOKEN_AUTH_KEY=your-token-auth-key
BUNNY_STREAM_PLAYBACK_TTL=3600
# Random shared secret used in the Bunny library "Webhook URL" setting:
#   https://api.padmakara.pt/api/webhooks/bunny?secret=THIS_VALUE
BUNNY_WEBHOOK_SECRET=generate-a-random-secret
