# Database
DATABASE_URL=postgresql://padmakara:your-db-password@localhost:5432/padmakara

# Test database (local development only, not needed in production)
# TEST_DATABASE_URL=postgresql://localhost:5432/padmakara_test

# JWT — generate with: openssl rand -base64 32
JWT_SECRET=change-me-to-a-random-secret-in-production
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d

# AWS S3
AWS_ACCESS_KEY_ID=your-aws-key
AWS_SECRET_ACCESS_KEY=your-aws-secret
AWS_REGION=eu-west-3
S3_BUCKET=your-s3-bucket-name

# Email (AWS SES)
SES_FROM_EMAIL=noreply@your-domain.com

# App
PORT=3000
NODE_ENV=production
FRONTEND_URL=https://your-domain.com
ADMIN_URL=https://admin.your-domain.com
BACKEND_URL=https://api.your-domain.com

# Easypay (Payment)
EASYPAY_ACCOUNT_ID=your-easypay-account-id
EASYPAY_API_KEY=your-easypay-api-key
EASYPAY_TESTING=false

# Read-Along (AWS Batch)
BATCH_JOB_DEFINITION=padmakara-read-along
BATCH_JOB_QUEUE=padmakara-read-along-queue
READ_ALONG_WEBHOOK_SECRET=generate-a-random-secret
