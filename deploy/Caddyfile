# Padmakara — the shared Caddy entry point.
#
# Caddy automatically provisions and renews Let's Encrypt HTTPS certificates.
#
# This file belongs to no application, and no deploy script overwrites it.
# Every site on this box lives in its own file under /etc/caddy/sites/, put
# there by the repository that owns it:
#
#     /etc/caddy/sites/padmakara-api.caddy    ← this repository
#     /etc/caddy/sites/tibetan-course.caddy   ← jerefrer/tibetan-course
#
# It used to hold the three vhosts directly, and deploy.sh copied it over
# /etc/caddy/Caddyfile every time. That was fine while one application had the
# machine to itself and became a trap the moment a second arrived: a vhost
# added by anyone else survived exactly until the next API deploy. Splitting
# the file is what removes that, permanently — deploying one application can no
# longer touch another's configuration.
#
# deploy.sh installs this file only when it is missing. Editing it is a
# deliberate act, not a side effect.
#
# DNS required: an A record per hostname, pointing at this server.

import /etc/caddy/sites/*.caddy
