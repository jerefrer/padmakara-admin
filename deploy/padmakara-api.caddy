# Padmakara API, admin panel and web app.
#
# This file is this repository's, dropped into /etc/caddy/sites/ by deploy.sh.
# /etc/caddy/Caddyfile holds nothing but the import that picks it up, so a
# deploy here cannot disturb another application's vhost and another
# application's deploy cannot disturb this one.

# API — reverse proxy to Bun on localhost:3000
api.padmakara.pt {
	reverse_proxy localhost:3000 {
		# These two make the trust model explicit rather than inherited.
		#
		# X-Forwarded-For was already safe: Caddy trusts no proxy by default, so
		# it overwrites the header instead of appending the peer to whatever the
		# caller sent. Verified on this box, Caddy 2.11.1, by proxying a request
		# carrying `X-Forwarded-For: 1.2.3.4` through a block with and without
		# this line — both delivered the real peer and nothing else. The line is
		# therefore not a fix. It states in the file what the application
		# depends on, so that a later `trusted_proxies` added for some other
		# reason cannot quietly turn src/middleware/rate-limit.ts — which reads
		# the first entry of the list — into a limiter the caller addresses.
		#
		# X-Real-IP is the one that was actually passing through untouched: the
		# same test delivered the caller's `9.9.9.9` verbatim. Nothing exploits
		# it today, because rate-limit.ts only falls back to it when
		# X-Forwarded-For is absent and Caddy always sets that. It is set here
		# so the fallback cannot become a hole the day a code path reads it
		# first.
		#
		# If a CDN is ever put in front of this origin, both lines have to be
		# revisited: the real client address would then arrive in a header from
		# the CDN, and {remote_host} would be the CDN.
		header_up X-Forwarded-For {remote_host}
		header_up X-Real-IP {remote_host}
	}

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		# `?` sets the field only when the response does not already carry it.
		# Without it Caddy overwrote the application's own value, which is how
		# the activation page's `Referrer-Policy: no-referrer` (it must not leak
		# the token in its URL to anything it loads) became
		# strict-origin-when-cross-origin. Note that `?` moves this field into
		# its own deferred handler; the other lines here still overwrite.
		?Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output file /var/log/caddy/api-access.log
		format json
	}
}

# Admin panel — static SPA with API proxy
admin.padmakara.pt {
	# Proxy API calls to Hono
	handle /api/* {
		reverse_proxy localhost:3000 {
			# The same door onto the same application — see the note above.
			header_up X-Forwarded-For {remote_host}
			header_up X-Real-IP {remote_host}
		}
	}

	# Serve admin SPA static files
	handle {
		root * /home/padmakara/padmakara-api/admin/dist
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# REPORT-ONLY for now: the browser logs violations to the console and
		# blocks nothing. Switch the header name to Content-Security-Policy once
		# the console has been checked in a browser on every admin screen
		# (event edit with uploads, video preview, slide editor, teachers).
		#
		# What each source is for, and where it was found:
		#   style-src 'unsafe-inline'  MUI/emotion injects <style> at runtime
		#   fonts.googleapis.com       admin/index.html stylesheet (EB Garamond, Inter)
		#   fonts.gstatic.com          the font files that stylesheet points to
		#   img-src https:             teacher photoUrl may be any external URL
		#                              (admin/src/resources/teachers.tsx)
		#   padmakara-pt-app.s3...,    presigned GET/PUT and multipart uploads
		#   *.r2.cloudflarestorage.com (src/services/s3.ts: AWS by default, R2 when
		#                              S3_ENDPOINT is set — both listed until prod
		#                              is confirmed, then drop the unused one)
		#   video.bunnycdn.com         Bunny TUS uploads (src/services/bunny.ts)
		#   *.b-cdn.net                Bunny Stream HLS and thumbnails
		#                              (BUNNY_STREAM_CDN_HOSTNAME, vz-*.b-cdn.net)
		#   iframe.mediadelivery.net   Bunny embed player (src/services/bunny.ts)
		#   blob:                      hls.js worker, local previews of picked files
		Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob: https://padmakara-pt-app.s3.eu-west-3.amazonaws.com https://*.r2.cloudflarestorage.com https://*.b-cdn.net; connect-src 'self' https://padmakara-pt-app.s3.eu-west-3.amazonaws.com https://*.r2.cloudflarestorage.com https://video.bunnycdn.com https://*.b-cdn.net; frame-src 'self' blob: https://iframe.mediadelivery.net; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; report-uri https://api.padmakara.pt/api/csp-report"
		-Server
	}

	log {
		output file /var/log/caddy/admin-access.log
		format json
	}
}

# Web app — static Expo web build
app.padmakara.pt {
	root * /home/padmakara/padmakara-app/dist

	try_files {path} /index.html
	file_server

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# REPORT-ONLY for now: the browser logs violations to the console and
		# blocks nothing. Switch the header name to Content-Security-Policy once
		# the console has been checked in a browser on: sign-in (code and
		# passkey), a teaching with audio, video and a transcript, a publication
		# PDF, and the membership checkout (card, MB WAY, Multibanco).
		#
		# What each source is for, and where it was found (padmakara-app):
		#   sha256-67fh...           the one inline script of the Expo static
		#                            export: globalThis.__EXPO_ROUTER_HYDRATE__=true;
		#                            (recompute if an Expo upgrade changes it)
		#   'wasm-unsafe-eval'       pdf.js decoders (wasmUrl in PDFViewerWebImpl.tsx)
		#   cdn.easypay.pt           checkout SDK 2.9.1
		#                            (components/membership/EasypayCheckout.web.tsx)
		#   pay.easypay.pt           the iframe that SDK opens (originUrl in the SDK;
		#                            pay.sandbox.easypay.pt is the testing one, not listed)
		#   cdn.jsdelivr.net         pdf.js worker, wasm, cmaps, standard fonts,
		#                            pinned pdfjs-dist (PDFViewerWebImpl.tsx)
		#   style-src 'unsafe-inline' react-native-web and the Easypay SDK inject styles
		#   api.padmakara.pt         EXPO_PUBLIC_API_URL (deploy.sh)
		#   padmakara-pt-app.s3...,  presigned images, audio, PDFs
		#   *.r2.cloudflarestorage.com (src/services/s3.ts: AWS by default, R2 when
		#                            S3_ENDPOINT is set — both listed until prod is
		#                            confirmed, then drop the unused one)
		#   *.b-cdn.net              Bunny Stream HLS and thumbnails (hls.js,
		#                            components/WebHlsVideo.web.tsx)
		#   iframe.mediadelivery.net Bunny embed player, the fallback (services/retreatService.ts)
		#   o4510993302618112.ingest.de.sentry.io  Sentry DSN in app.config.ts
		#   blob:                    hls.js and pdf.js workers, PDFs and audio fetched
		#                            then shown from object URLs
		#   fonts                    bundled by Expo (EB Garamond, icon fonts): 'self'
		#   img-src https:           teacher and group photos may come from any external
		#                            site (photoUrl), seen on 2026-11-16 (khyentsevision.org)
		Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'sha256-67fhrP0+BkBqmgGGXTtgiVO/9EQs3QruYNU/7fnRkI8=' 'wasm-unsafe-eval' https://cdn.easypay.pt https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; font-src 'self' data: https://cdn.jsdelivr.net; img-src 'self' data: blob: https:; media-src 'self' blob: https://padmakara-pt-app.s3.eu-west-3.amazonaws.com https://*.r2.cloudflarestorage.com https://*.b-cdn.net; connect-src 'self' https://api.padmakara.pt https://padmakara-pt-app.s3.eu-west-3.amazonaws.com https://*.r2.cloudflarestorage.com https://*.b-cdn.net https://cdn.jsdelivr.net https://o4510993302618112.ingest.de.sentry.io; frame-src 'self' blob: https://pay.easypay.pt https://iframe.mediadelivery.net; worker-src 'self' blob: https://cdn.jsdelivr.net; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; report-uri https://api.padmakara.pt/api/csp-report"
		-Server
	}

	@static path /_expo/* /assets/*
	header @static Cache-Control "public, max-age=31536000, immutable"

	# Apple fetches this extensionless file for passkeys and requires JSON.
	# try_files {path} serves the real file under .well-known when it exists,
	# so the SPA fallback to /index.html never shadows it.
	@aasa path /.well-known/apple-app-site-association
	header @aasa Content-Type application/json

	log {
		output file /var/log/caddy/web-access.log
		format json
	}
}
